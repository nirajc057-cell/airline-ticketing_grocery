FROM ghcr.io/cirruslabs/flutter:3.44.0 AS build

WORKDIR /app/flutter_app
COPY flutter_app/pubspec.yaml flutter_app/pubspec.lock ./
RUN flutter pub get
COPY flutter_app/ ./
RUN flutter build web --release --pwa-strategy=none \
    && RELEASE_HASH="$(sha256sum build/web/main.dart.js | cut -c1-12)" \
    && sed -i "s|main.dart.js|main.dart.js?v=${RELEASE_HASH}|g" build/web/flutter_bootstrap.js \
    && sed -i "s|flutter_bootstrap.js|flutter_bootstrap.js?v=${RELEASE_HASH}|g" build/web/index.html

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/flutter_app/build/web /usr/share/nginx/html
EXPOSE 80
