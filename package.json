{
  "name": "aerodesk-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first B2B airline ticketing and agency operations platform",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test.js",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "db:check": "node backend/migrate-json.js --dry-run",
    "db:migrate": "node backend/migrate-json.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.0"
  }
}
